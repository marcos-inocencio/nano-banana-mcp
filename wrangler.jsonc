{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nano-banana-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "r2_buckets": [{ "binding": "IMAGE_BUCKET", "bucket_name": "nano-banana-images" }],
  // No deployment works until these placeholders and the secrets are configured.
  "vars": {
    "PUBLIC_URL": "https://nano-banana-mcp.YOUR-SUBDOMAIN.workers.dev",
    "OAUTH_ISSUER": "https://YOUR-TENANT.example.com/",
    "OAUTH_JWKS_URL": "https://YOUR-TENANT.example.com/.well-known/jwks.json",
    "ALLOWED_ORIGINS": "https://claude.ai,https://claude.com"
  },
  "ratelimits": [{
    "name": "IMAGE_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 5, "period": 60 }
  }]
}
